<#
Claude Code Provider Setup -- configure an Anthropic-compatible endpoint.

Run:
  pwsh -NoProfile -File .\claude-provider-setup.ps1
#>

# {{GENERATED_HEADER}}
# {{SCRIPT_VERSION}}
# {{MESSAGES}}
# {{TYPE_STYLES}}

$ErrorActionPreference = 'Stop'
$ABORT_SENTINEL = '__CLAUDE_PROVIDER_SETUP_ABORT__'
$ClaudeConfigDir = if ($env:CLAUDE_CONFIG_DIR) {
    $env:CLAUDE_CONFIG_DIR
} else {
    Join-Path $HOME '.claude'
}
$SettingsPath = Join-Path $ClaudeConfigDir 'settings.json'
$BackupDir = Join-Path $ClaudeConfigDir '.provider-backup'
$BackupSettings = Join-Path $BackupDir 'settings.json'
$ManifestPath = Join-Path $BackupDir 'manifest.txt'

$script:HasInteractionUI = $false

function Get-Message {
    param(
        [string] $Name,
        [object[]] $Values = @()
    )

    $template = [string] $MESSAGES[$Name]
    if ($Values.Count -eq 0) {
        return $template
    }
    return ($template -f $Values)
}

function Write-Message {
    param(
        [string] $Content,
        [string] $Type,
        [AllowEmptyString()] [string] $Suffix = '',
        [switch] $NoNewline
    )

    if ($TYPE_STYLES.ContainsKey($Type) -and $Type -notin @( 'Title', 'Ordered' )) {
        $style = $TYPE_STYLES[$Type]
        $marker = $style.Marker
    } elseif ($Type -match '^\d+$') {
        $style = $TYPE_STYLES.Ordered
        $marker = $Type
    } else {
        throw "Unknown UI message type: $Type"
    }
    Write-Host "[$marker] " -ForegroundColor $style.Color -NoNewline
    Write-Host ($Content + $Suffix) -NoNewline:$NoNewline
}

function Write-Title {
    param([string] $Content)

    Write-Host "${Content}:" -ForegroundColor $TYPE_STYLES.Title.Color
}

function Write-Input {
    param([string] $Content)

    Write-Message -Content $Content -Type 'Prompt' -Suffix ': ' -NoNewline
}

function Start-InteractionUI {
    if ($script:HasInteractionUI) {
        Write-Host ''
    }
    $script:HasInteractionUI = $true
}

function Write-Table {
    param(
        [string] $Title,
        [string[]] $Items,
        [string[]] $Types = @(),
        [ValidateSet('Ordered', 'Unordered')]
        [string] $Kind = 'Unordered'
    )

    Write-Title -Content $Title
    for ($index = 0; $index -lt $Items.Count; $index++) {
        $type = if ($Kind -eq 'Ordered') {
            $Types[$index]
        } elseif ($Types.Count -gt $index) {
            $Types[$index]
        } else {
            'Info'
        }
        Write-Message -Content $Items[$index] -Type $type
    }
}

function Get-FieldItems {
    param(
        [string[]] $Keys,
        [string[]] $Values
    )

    $items = New-Object 'System.Collections.Generic.List[string]'
    for ($index = 0; $index -lt $Values.Count; $index++) {
        $items.Add("$($Keys[$index]): $($Values[$index])")
    }
    return $items.ToArray()
}

function Read-Input {
    param(
        [string] $Prompt,
        [switch] $AsSecureString
    )

    Write-Input -Content $Prompt
    if ($AsSecureString) {
        return (Read-Host -AsSecureString)
    }
    return (Read-Host)
}

function Read-InputUI {
    [CmdletBinding(DefaultParameterSetName = 'Message')]
    param(
        [Parameter(Mandatory = $true, ParameterSetName = 'Message')]
        [string] $MessageContent,
        [Parameter(ParameterSetName = 'Message')]
        [ValidateSet('Info', 'Detail', 'Success', 'Warning', 'Error')]
        [string] $MessageType = 'Info',
        [Parameter(Mandatory = $true, ParameterSetName = 'Table')]
        [string] $TableTitle,
        [Parameter(Mandatory = $true, ParameterSetName = 'Table')]
        [string[]] $TableItems,
        [Parameter(ParameterSetName = 'Table')]
        [string[]] $TableTypes = @(),
        [Parameter(ParameterSetName = 'Table')]
        [ValidateSet('Ordered', 'Unordered')]
        [string] $TableKind = 'Unordered',
        [Parameter(Mandatory = $true)]
        [string] $Prompt,
        [switch] $AsSecureString
    )

    Start-InteractionUI
    if ($PSCmdlet.ParameterSetName -eq 'Message') {
        Write-Message -Content $MessageContent -Type $MessageType
    } else {
        Write-Table -Title $TableTitle -Items $TableItems -Types $TableTypes -Kind $TableKind
    }
    return (Read-Input -Prompt $Prompt -AsSecureString:$AsSecureString)
}

function Write-FeedbackUI {
    [CmdletBinding(DefaultParameterSetName = 'Message')]
    param(
        [Parameter(Mandatory = $true, ParameterSetName = 'Message')]
        [string] $MessageContent,
        [Parameter(ParameterSetName = 'Message')]
        [ValidateSet('Info', 'Detail', 'Success', 'Warning', 'Error')]
        [string] $MessageType = 'Info',
        [Parameter(Mandatory = $true, ParameterSetName = 'Table')]
        [string] $TableTitle,
        [Parameter(Mandatory = $true, ParameterSetName = 'Table')]
        [string[]] $TableItems,
        [Parameter(ParameterSetName = 'Table')]
        [string[]] $TableTypes = @(),
        [Parameter(ParameterSetName = 'Table')]
        [ValidateSet('Ordered', 'Unordered')]
        [string] $TableKind = 'Unordered'
    )

    Start-InteractionUI
    if ($PSCmdlet.ParameterSetName -eq 'Message') {
        Write-Message -Content $MessageContent -Type $MessageType
    } else {
        Write-Table -Title $TableTitle -Items $TableItems -Types $TableTypes -Kind $TableKind
    }
}

function Stop-Setup {
    param([string] $Message)

    Write-FeedbackUI -MessageContent $Message -MessageType 'Error'
    throw $ABORT_SENTINEL
}

function Read-RequiredValue {
    param(
        [string] $Message,
        [string] $Prompt
    )

    for ($attempt = 0; $attempt -lt 3; $attempt++) {
        try {
            $value = (Read-InputUI -MessageContent $Message -MessageType 'Info' -Prompt $Prompt).Trim()
        } catch {
            Stop-Setup (Get-Message 'InputUnavailable')
        }
        if ($value) {
            return $value
        }
        Write-FeedbackUI -MessageContent (Get-Message 'ValueRequired') -MessageType 'Warning'
    }
    Stop-Setup (Get-Message 'ValueLimit')
}

function Read-ValueWithDefault {
    param(
        [string] $Title,
        [string] $Prompt,
        [string] $Default
    )

    $items = Get-FieldItems @((Get-Message 'DefaultField')) @($Default)
    try {
        $value = (
            Read-InputUI -TableTitle $Title -TableItems $items -TableTypes @(
                'Info'
            ) -TableKind 'Unordered' -Prompt $Prompt
        ).Trim()
    } catch {
        Stop-Setup (Get-Message 'InputUnavailable')
    }
    if ($value) {
        return $value
    }
    return $Default
}

function Read-ApiKey {
    param(
        [string] $Title,
        [string[]] $Items,
        [string[]] $Types
    )

    for ($attempt = 0; $attempt -lt 3; $attempt++) {
        try {
            $secureValue = Read-InputUI -TableTitle $Title -TableItems $Items -TableTypes $Types -TableKind 'Unordered' -Prompt (
                Get-Message 'ClaudeApiKeyPrompt'
            ) -AsSecureString
        } catch {
            Stop-Setup (Get-Message 'ApiKeyUnavailable')
        }
        $pointer = [IntPtr]::Zero
        try {
            $pointer = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secureValue)
            $plainValue = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($pointer)
        } finally {
            if ($pointer -ne [IntPtr]::Zero) {
                [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($pointer)
            }
        }
        if ($plainValue) {
            if ($plainValue -match '[\r\n]') {
                Stop-Setup (Get-Message 'ApiKeyLineBreaks')
            }
            return $plainValue
        }
        Write-FeedbackUI -MessageContent (Get-Message 'ApiKeyRequired') -MessageType 'Warning'
    }
    Stop-Setup (Get-Message 'ApiKeyLimit')
}

function Resolve-BaseUrl {
    param([string] $Value)

    $candidate = $Value.Trim()
    if (-not $candidate) {
        Stop-Setup (Get-Message 'BaseUrlRequired')
    }
    if ($candidate -notmatch '^[A-Za-z][A-Za-z0-9+.-]*://') {
        $localPattern = '^(?i)(localhost|0\.0\.0\.0|127(?:\.\d{1,3}){3}|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2}|\[::1\])(?::\d+)?(?:/|$)'
        $scheme = if ($candidate -match $localPattern) {
            'http'
        } else {
            'https'
        }
        $candidate = "${scheme}://$candidate"
        Write-FeedbackUI -MessageContent (Get-Message 'BaseUrlExpanded' $candidate) -MessageType 'Detail'
    }
    $parsed = $null
    if (-not [Uri]::TryCreate( $candidate, [UriKind]::Absolute, [ref] $parsed )) {
        Stop-Setup (Get-Message 'BaseUrlInvalid' $candidate)
    }
    if ($parsed.Scheme -notin @( 'http', 'https' )) {
        Stop-Setup (Get-Message 'BaseUrlScheme')
    }
    if ($parsed.UserInfo) {
        Stop-Setup (Get-Message 'BaseUrlCredentials')
    }
    if (-not $parsed.Host) {
        Stop-Setup (Get-Message 'BaseUrlInvalid' $candidate)
    }
    Write-FeedbackUI -MessageContent (Get-Message 'BaseUrlSecurityWarning') -MessageType 'Warning'
    return $parsed.AbsoluteUri
}

function Initialize-Backup {
    if (Test-Path -LiteralPath $BackupDir) {
        if (
            (Get-Content -LiteralPath $ManifestPath -Raw -ErrorAction SilentlyContinue) -notmatch
            '(?m)^original_settings_existed=1\r?$'
        ) {
            return $false
        }
        if (-not (Test-Path -LiteralPath $BackupSettings)) {
            throw "Backup is damaged: $BackupSettings"
        }
        return $true
    }
    $existed = Test-Path -LiteralPath $SettingsPath
    New-Item -ItemType Directory -Path $BackupDir -Force | Out-Null
    if ($existed) {
        Copy-Item -LiteralPath $SettingsPath -Destination $BackupSettings -Force
    }
    Set-Content -LiteralPath $ManifestPath -Value @(
        'format_version=1'
        "script_version=$SCRIPT_VERSION"
        "original_settings_existed=$(if ($existed) { 1 } else { 0 })"
    ) -Encoding UTF8
    return $true
}

function Write-Settings {
    param(
        [string] $Provider,
        [string] $BaseUrl,
        [string] $Model,
        [string] $Token
    )

    $settings = if (Test-Path -LiteralPath $SettingsPath) {
        $text = Get-Content -LiteralPath $SettingsPath -Raw -Encoding UTF8
        if ($text.Trim()) {
            $text | ConvertFrom-Json
        } else {
            [pscustomobject] @{}
        }
    } else {
        [pscustomobject] @{}
    }
    if (-not $settings) {
        $settings = [pscustomobject] @{}
    }
    if ($settings -is [array]) {
        throw 'settings.json must contain an object.'
    }
    $settingsPropertyNames = @(
        $settings.PSObject.Properties | ForEach-Object {
            $_.Name
        }
    )
    if (-not ($settingsPropertyNames -contains 'env') -or $null -eq $settings.env) {
        $settings | Add-Member -NotePropertyName env -NotePropertyValue ([pscustomobject] @{})
    }
    $envPropertyNames = @(
        $settings.env.PSObject.Properties | ForEach-Object {
            $_.Name
        }
    )
    foreach (
        $property in @(
            @{ Name = 'ANTHROPIC_BASE_URL'; Value = $BaseUrl },
            @{ Name = 'ANTHROPIC_AUTH_TOKEN'; Value = $Token }
        )
    ) {
        if ($property.Name -in $envPropertyNames) {
            $settings.env.($property.Name) = $property.Value
        } else {
            $settings.env | Add-Member -NotePropertyName $property.Name -NotePropertyValue $property.Value
        }
    }
    $defaultModelKeys = @(
        'ANTHROPIC_DEFAULT_OPUS_MODEL',
        'ANTHROPIC_DEFAULT_SONNET_MODEL',
        'ANTHROPIC_DEFAULT_HAIKU_MODEL'
    )
    $envPropertyNames = @(
        $settings.env.PSObject.Properties | ForEach-Object {
            $_.Name
        }
    )
    $hasDefaultModel = @(
        $defaultModelKeys | Where-Object {
            $_ -in $envPropertyNames -and [bool] $settings.env.$_
        }
    ).Count -gt 0
    if (-not $hasDefaultModel) {
        foreach ($name in $defaultModelKeys) {
            if ($name -in $envPropertyNames) {
                $settings.env.$name = $Model
            } else {
                $settings.env | Add-Member -NotePropertyName $name -NotePropertyValue $Model
            }
        }
    }
    if (-not $hasDefaultModel -or 'ANTHROPIC_MODEL' -in $envPropertyNames) {
        if ('ANTHROPIC_MODEL' -in $envPropertyNames) {
            $settings.env.ANTHROPIC_MODEL = $Model
        } else {
            $settings.env | Add-Member -NotePropertyName ANTHROPIC_MODEL -NotePropertyValue $Model
        }
    }
    if ('CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC' -notin $envPropertyNames) {
        $settings.env | Add-Member -NotePropertyName CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC -NotePropertyValue '1'
    }
    if ('ANTHROPIC_API_KEY' -in $envPropertyNames) {
        $settings.env.PSObject.Properties.Remove('ANTHROPIC_API_KEY')
    }
    New-Item -ItemType Directory -Path $ClaudeConfigDir -Force | Out-Null
    $temp = "$SettingsPath.$PID.tmp"
    $settings | ConvertTo-Json -Depth 20 | Set-Content -LiteralPath $temp -Encoding UTF8
    Move-Item -LiteralPath $temp -Destination $SettingsPath -Force
}

function Invoke-Configure {
    Write-FeedbackUI -TableTitle (Get-Message 'ClaudeAppTitle' $SCRIPT_VERSION) -TableItems @(
        (Get-Message 'ClaudeConfigDir' $ClaudeConfigDir)
    ) -TableTypes @('Detail') -TableKind 'Unordered'
    $provider = Read-RequiredValue (Get-Message 'ClaudeProviderInputMessage') (Get-Message 'ClaudeProviderPrompt')
    $baseUrlInput = Read-ValueWithDefault (Get-Message 'ClaudeBaseUrlInputTitle') (
        Get-Message 'ClaudeDefaultBaseUrlPrompt'
    ) 'https://api.anthropic.com'
    $baseUrl = Resolve-BaseUrl $baseUrlInput
    $model = Read-ValueWithDefault (Get-Message 'ClaudeModelInputTitle') (
        Get-Message 'ClaudeDefaultModelPrompt'
    ) 'claude-sonnet-4-5'
    $token = Read-ApiKey (Get-Message 'ClaudeApiKeyTitle') @((Get-Message 'ClaudeApiWarning')) @('Warning')
    if (-not (Initialize-Backup)) {
        Stop-Setup (Get-Message 'BackupIncomplete')
    }
    try {
        Write-Settings $provider $baseUrl $model $token
    } catch {
        Stop-Setup $_.Exception.Message
    }
    Write-FeedbackUI -MessageContent (Get-Message 'ClaudeConfigUpdated' $SettingsPath) -MessageType 'Success'
    Write-FeedbackUI -TableTitle (Get-Message 'ConfigCompleteTitle') -TableItems @(
        "$(Get-Message 'ProviderField'): $provider",
        "$(Get-Message 'BaseUrlField'): $baseUrl",
        "$(Get-Message 'ModelField'): $model"
    ) -TableTypes @( 'Change', 'Change', 'Change' ) -TableKind 'Unordered'
    Write-FeedbackUI -MessageContent (Get-Message 'ClaudeRestart') -MessageType 'Info'
}

function Invoke-Restore {
    if (-not (Test-Path -LiteralPath $BackupDir)) {
        Write-FeedbackUI -MessageContent (Get-Message 'ClaudeNoRestorableConfig') -MessageType 'Info'
        return
    }
    $manifest = Get-Content -LiteralPath $ManifestPath -Raw -ErrorAction SilentlyContinue
    if ($manifest -notmatch '(?m)^original_settings_existed=1\r?$' -or -not (Test-Path -LiteralPath $BackupSettings)) {
        Write-FeedbackUI -MessageContent (Get-Message 'ClaudeNoRestorableConfig') -MessageType 'Error'
        return
    }
    Write-FeedbackUI -MessageContent "$(Get-Message 'ClaudeRestoreTitle'). $(Get-Message 'ClaudeRestoreWarning')" -MessageType 'Warning'
    Copy-Item -LiteralPath $BackupSettings -Destination $SettingsPath -Force
    Remove-Item -LiteralPath $BackupDir -Recurse -Force
    Write-FeedbackUI -MessageContent (Get-Message 'ClaudeRestored') -MessageType 'Success'
}

if ($env:CLAUDE_PROVIDER_SETUP_SKIP_MAIN -ne '1') {
    if ($args.Count -eq 0 -or $args[0] -eq 'configure') {
        Invoke-Configure
    } elseif ($args[0] -eq 'restore') {
        Invoke-Restore
    } else {
        Write-FeedbackUI -MessageContent "Unknown action: $($args[0])" -MessageType 'Error'
        exit 1
    }
}
