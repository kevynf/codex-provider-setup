<#
Codex Provider Setup -- interactive custom-provider configuration for Windows.

Run:
  pwsh -NoProfile -File .\codex-provider-setup.ps1

Windows PowerShell 5.1 (read this UTF-8 file explicitly):
  Get-Content .\codex-provider-setup.ps1 -Raw -Encoding UTF8 | Invoke-Expression
#>

# {{GENERATED_HEADER}}
# {{SCRIPT_VERSION}}
$PROVIDER_PREFIX = 'codex_provider_setup_'
$BACKUP_DIRNAME = '.provider-backup'
$ABORT_SENTINEL = '__CODEX_PROVIDER_SETUP_ABORT__'
# {{MODEL_PRESETS}}
# {{MESSAGES}}
# {{TYPE_STYLES}}

function Get-Message {
    param(
        [string] $Name,
        [object[]] $Values = @()
    )

    $template = [string] $MESSAGES[$Name]
    if ($Values.Count -eq 0) {
        return $template
    }
    return ($template -f $Values)
}

$script:HasInteractionUI = $false

function Write-Message {
    param(
        [string] $Content,
        [string] $Type,
        [AllowEmptyString()] [string] $Suffix = '',
        [switch] $NoNewline
    )

    if ($TYPE_STYLES.ContainsKey($Type) -and $Type -notin @( 'Title', 'Ordered' )) {
        $style = $TYPE_STYLES[$Type]
        $Marker = $style.Marker
    } elseif ($Type -match '^\d+$') {
        $style = $TYPE_STYLES.Ordered
        $Marker = $Type
    } else {
        throw "Unknown UI message type: $Type"
    }
    Write-Host "[$Marker] " -ForegroundColor $style.Color -NoNewline
    Write-Host ($Content + $Suffix) -NoNewline:$NoNewline
}

function Write-Title {
    param([string] $Content)

    Write-Host "${Content}:" -ForegroundColor $TYPE_STYLES.Title.Color
}

function Write-Input {
    param([string] $Content)

    Write-Message -Content $Content -Type 'Prompt' -Suffix ': ' -NoNewline
}

function Start-InteractionUI {
    if ($script:HasInteractionUI) {
        Write-Host ''
    }
    $script:HasInteractionUI = $true
}

function Write-Table {
    param(
        [string] $Title,
        [string[]] $Items,
        [string[]] $Types = @(),
        [ValidateSet('Ordered', 'Unordered')]
        [string] $Kind = 'Unordered'
    )

    Write-Title -Content $Title
    for ($index = 0; $index -lt $Items.Count; $index++) {
        $type = if ($Kind -eq 'Ordered') {
            $Types[$index]
        } elseif ($Types.Count -gt $index) {
            $Types[$index]
        } else {
            'Info'
        }
        Write-Message -Content $Items[$index] -Type $type
    }
}

function Get-FieldItems {
    param(
        [string[]] $Keys,
        [string[]] $Values
    )

    $items = New-Object 'System.Collections.Generic.List[string]'
    for ($index = 0; $index -lt $Values.Count; $index++) {
        $items.Add("$($Keys[$index]): $($Values[$index])")
    }
    return $items.ToArray()
}

function Stop-Setup {
    param([string] $Message)

    Write-FeedbackUI -MessageContent $Message -MessageType 'Error'
    throw $ABORT_SENTINEL
}

$CodexHomeDir = if ($env:CODEX_HOME) {
    $env:CODEX_HOME
} else {
    Join-Path $HOME '.codex'
}
$ConfigPath = Join-Path $CodexHomeDir 'config.toml'
$BackupDir = Join-Path $CodexHomeDir $BACKUP_DIRNAME
$BackupConfig = Join-Path $BackupDir 'config.toml'
$ManifestPath = Join-Path $BackupDir 'manifest.txt'

$script:Depth = 0
$script:MultilineState = ''

function Update-TomlScanState {
    param([string] $Line)

    $length = $Line.Length
    $index = 0
    $inlineState = ''
    while ($index -lt $length) {
        $char = $Line[$index]
        $three = if ($index + 3 -le $length) {
            $Line.Substring( $index, 3 )
        } else {
            ''
        }
        if ($script:MultilineState) {
            if ($script:MultilineState -eq 'basic' -and $three -eq '"""') {
                $script:MultilineState = ''
                $index += 3
                continue
            }
            if ($script:MultilineState -eq 'literal' -and $three -eq "'''") {
                $script:MultilineState = ''
                $index += 3
                continue
            }
            if ($script:MultilineState -eq 'basic' -and $char -eq '\') {
                $index += 2
                continue
            }
            $index++
            continue
        }
        if ($inlineState) {
            if ($inlineState -eq 'basic') {
                if ($char -eq '\') {
                    $index += 2
                    continue
                }
                if ($char -eq '"') {
                    $inlineState = ''
                }
            } elseif ($char -eq "'") {
                $inlineState = ''
            }
            $index++
            continue
        }
        if ($three -eq '"""') {
            $script:MultilineState = 'basic'
            $index += 3
            continue
        }
        if ($three -eq "'''") {
            $script:MultilineState = 'literal'
            $index += 3
            continue
        }
        switch ($char) {
            '#' {
                return
            }
            '"' {
                $inlineState = 'basic'
            }
            "'" {
                $inlineState = 'literal'
            }
            '[' {
                $script:Depth++
            }
            ']' {
                if ($script:Depth -gt 0) {
                    $script:Depth--
                }
            }
        }
        $index++
    }
}

function Get-TomlKey {
    param([string] $Line)

    $trimmed = $Line.Trim()
    if (-not $trimmed -or $trimmed.StartsWith('#')) {
        return ''
    }
    $equals = $trimmed.IndexOf('=')
    if ($equals -lt 1) {
        return ''
    }
    return $trimmed.Substring( 0, $equals ).Trim().Trim('"').Trim("'")
}

function Get-TomlValue {
    param([string] $Line)

    $index = 0
    $length = $Line.Length
    $quote = ''
    while ($index -lt $length) {
        $char = $Line[$index]
        if ($quote) {
            if ($quote -eq '"' -and $char -eq '\' -and $index + 1 -lt $length) {
                $index += 2
                continue
            }
            if ($char -eq $quote) {
                $quote = ''
            }
            $index++
            continue
        }
        if ($char -eq '"' -or $char -eq "'") {
            $quote = [string] $char
            $index++
            continue
        }
        if ($char -eq '=') {
            return $Line.Substring($index + 1).Trim()
        }
        $index++
    }
    return ''
}

function ConvertFrom-TomlString {
    param([AllowEmptyString()] [string] $Value)

    $text = $Value.Trim()
    if ($text.Length -ge 2 -and $text.StartsWith('"') -and $text.EndsWith('"')) {
        $inner = $text.Substring( 1, $text.Length - 2 )
        $builder = New-Object System.Text.StringBuilder
        $index = 0
        while ($index -lt $inner.Length) {
            $char = $inner[$index]
            if ($char -ne '\' -or $index + 1 -ge $inner.Length) {
                [void] $builder.Append($char)
                $index++
                continue
            }
            $escape = $inner[$index + 1]
            $index += 2
            switch ($escape) {
                'n' {
                    [void] $builder.Append("`n")
                }
                't' {
                    [void] $builder.Append("`t")
                }
                'r' {
                    [void] $builder.Append("`r")
                }
                'b' {
                    [void] $builder.Append("`b")
                }
                'f' {
                    [void] $builder.Append("`f")
                }
                '"' {
                    [void] $builder.Append('"')
                }
                '\' {
                    [void] $builder.Append('\')
                }
                default {
                    [void] $builder.Append('\')
                    [void] $builder.Append($escape)
                }
            }
        }
        return $builder.ToString()
    }
    if ($text.Length -ge 2 -and $text.StartsWith("'") -and $text.EndsWith("'")) {
        return $text.Substring( 1, $text.Length - 2 )
    }
    return $text
}

function Get-TomlSectionPath {
    param([string] $Line)

    $trimmed = $Line.Trim()
    if (-not $trimmed.StartsWith('[')) {
        return ''
    }
    $segments = New-Object 'System.Collections.Generic.List[string]'
    $builder = New-Object System.Text.StringBuilder
    $quote = ''
    $quoted = $false
    for ($index = 1; $index -lt $trimmed.Length; $index++) {
        $char = $trimmed[$index]
        if ($quote) {
            if ($quote -eq '"' -and $char -eq '\' -and $index + 1 -lt $trimmed.Length) {
                $index++
                [void] $builder.Append($trimmed[$index])
            } elseif ($char -eq $quote) {
                $quote = ''
            } else {
                [void] $builder.Append($char)
            }
            continue
        }
        if ($char -eq '"' -or $char -eq "'") {
            if (-not $builder.ToString().Trim()) {
                [void] $builder.Clear()
            }
            $quote = [string] $char
            $quoted = $true
            continue
        }
        if ($char -eq '.' -or $char -eq ']') {
            $segment = $builder.ToString()
            if (-not $quoted) {
                $segment = $segment.Trim()
            }
            $segments.Add($segment)
            [void] $builder.Clear()
            $quoted = $false
            if ($char -eq ']') {
                return $segments.ToArray()
            }
            continue
        }
        [void] $builder.Append($char)
    }
    return @()
}

function Test-ProviderSection {
    param(
        [string] $Line,
        [string] $ProviderId,
        [switch] $Exact
    )

    $path = @(Get-TomlSectionPath $Line)
    if ($path.Count -lt 2 -or $path[0] -cne 'model_providers' -or $path[1] -cne $ProviderId) {
        return $false
    }
    return (-not $Exact -or $path.Count -eq 2)
}

function Get-TopLevelSetting {
    param(
        [string[]] $Lines,
        [string] $Name
    )

    $script:Depth = 0
    $script:MultilineState = ''
    foreach ($line in $Lines) {
        $trimmed = $line.Trim()
        if (-not $script:MultilineState -and $script:Depth -eq 0 -and $trimmed.StartsWith('[')) {
            break
        }
        if (-not $script:MultilineState -and $script:Depth -eq 0 -and (Get-TomlKey $line) -ceq $Name) {
            return (ConvertFrom-TomlString (Get-TomlValue $line))
        }
        Update-TomlScanState $line
    }
    return ''
}

function Get-ProviderInfo {
    param(
        [string[]] $Lines,
        [string] $ProviderId
    )

    $state = [pscustomobject] @{
        Id = $ProviderId
        Present = $false
        Recognizable = $true
        ProviderName = ''
        BaseUrl = ''
    }
    $script:Depth = 0
    $script:MultilineState = ''
    $inProvider = $false
    foreach ($line in $Lines) {
        $trimmed = $line.Trim()
        if (-not $script:MultilineState -and $script:Depth -eq 0 -and $trimmed.StartsWith('[')) {
            if (Test-ProviderSection $line $ProviderId -Exact) {
                $inProvider = $true
                $state.Present = $true
            } elseif (Test-ProviderSection $line $ProviderId) {
                $inProvider = $false
                $state.Recognizable = $false
            } else {
                $inProvider = $false
            }
            Update-TomlScanState $line
            continue
        }
        if ($inProvider -and -not $script:MultilineState -and $script:Depth -eq 0) {
            $key = Get-TomlKey $line
            if ($key) {
                if ($key -notin @( 'name', 'base_url', 'wire_api', 'experimental_bearer_token' )) {
                    $state.Recognizable = $false
                }
                $value = ConvertFrom-TomlString (Get-TomlValue $line)
                if ($key -ceq 'name') {
                    $state.ProviderName = $value
                } elseif ($key -ceq 'base_url') {
                    $state.BaseUrl = $value
                }
            }
        }
        Update-TomlScanState $line
    }
    return $state
}

function ConvertTo-TomlString {
    param([AllowEmptyString()] [string] $Value)

    $builder = New-Object System.Text.StringBuilder
    [void] $builder.Append('"')
    foreach ($char in $Value.ToCharArray()) {
        $code = [int] [char] $char
        if ($code -eq 8) {
            [void] $builder.Append('\b')
        }
        elseif ($code -eq 9) {
            [void] $builder.Append('\t')
        }
        elseif ($code -eq 10) {
            [void] $builder.Append('\n')
        }
        elseif ($code -eq 12) {
            [void] $builder.Append('\f')
        }
        elseif ($code -eq 13) {
            [void] $builder.Append('\r')
        }
        elseif ($code -eq 34) {
            [void] $builder.Append('\"')
        }
        elseif ($code -eq 92) {
            [void] $builder.Append('\\')
        }
        elseif ($code -lt 0x20 -or $code -eq 0x7f) {
            [void] $builder.Append(('\u{0:X4}' -f $code))
        }
        else {
            [void] $builder.Append($char)
        }
    }
    [void] $builder.Append('"')
    return $builder.ToString()
}

function Read-Input {
    param(
        [string] $Prompt,
        [switch] $AsSecureString
    )

    Write-Input -Content $Prompt
    if ($AsSecureString) {
        return (Read-Host -AsSecureString)
    }
    return (Read-Host)
}

function Read-InputUI {
    [CmdletBinding(DefaultParameterSetName = 'Message')]
    param(
        [Parameter(Mandatory = $true, ParameterSetName = 'Message')]
        [string] $MessageContent,
        [Parameter(ParameterSetName = 'Message')]
        [ValidateSet('Info', 'Detail', 'Success', 'Warning', 'Error')]
        [string] $MessageType = 'Info',
        [Parameter(Mandatory = $true, ParameterSetName = 'Table')]
        [string] $TableTitle,
        [Parameter(Mandatory = $true, ParameterSetName = 'Table')]
        [string[]] $TableItems,
        [Parameter(ParameterSetName = 'Table')]
        [string[]] $TableTypes = @(),
        [Parameter(ParameterSetName = 'Table')]
        [ValidateSet('Ordered', 'Unordered')]
        [string] $TableKind = 'Unordered',
        [Parameter(Mandatory = $true)]
        [string] $Prompt,
        [switch] $AsSecureString
    )

    Start-InteractionUI
    if ($PSCmdlet.ParameterSetName -eq 'Message') {
        Write-Message -Content $MessageContent -Type $MessageType
    } else {
        Write-Table -Title $TableTitle -Items $TableItems -Types $TableTypes -Kind $TableKind
    }
    return (Read-Input -Prompt $Prompt -AsSecureString:$AsSecureString)
}

function Write-FeedbackUI {
    [CmdletBinding(DefaultParameterSetName = 'Message')]
    param(
        [Parameter(Mandatory = $true, ParameterSetName = 'Message')]
        [string] $MessageContent,
        [Parameter(ParameterSetName = 'Message')]
        [ValidateSet('Info', 'Detail', 'Success', 'Warning', 'Error')]
        [string] $MessageType = 'Info',
        [Parameter(Mandatory = $true, ParameterSetName = 'Table')]
        [string] $TableTitle,
        [Parameter(Mandatory = $true, ParameterSetName = 'Table')]
        [string[]] $TableItems,
        [Parameter(ParameterSetName = 'Table')]
        [string[]] $TableTypes = @(),
        [Parameter(ParameterSetName = 'Table')]
        [ValidateSet('Ordered', 'Unordered')]
        [string] $TableKind = 'Unordered'
    )

    Start-InteractionUI
    if ($PSCmdlet.ParameterSetName -eq 'Message') {
        Write-Message -Content $MessageContent -Type $MessageType
    } else {
        Write-Table -Title $TableTitle -Items $TableItems -Types $TableTypes -Kind $TableKind
    }
}

function Read-Choice {
    param(
        [string] $Title,
        [string[]] $Keys,
        [string[]] $Items,
        [string] $Prompt
    )

    for ($attempt = 0; $attempt -lt 3; $attempt++) {
        try {
            $choice = (
                Read-InputUI -TableTitle $Title -TableItems $Items -TableTypes $Keys -TableKind 'Ordered' -Prompt $Prompt
            ).Trim()
        } catch {
            Stop-Setup (Get-Message 'InputUnavailable')
        }
        if ($choice -in $Keys) {
            return $choice
        }
        Write-FeedbackUI -MessageContent (Get-Message 'InvalidInput'($Keys -join ', ')) -MessageType 'Warning'
    }
    Stop-Setup (Get-Message 'InvalidInputLimit')
}

function Read-RequiredValue {
    param(
        [string] $Message,
        [string] $Prompt
    )

    for ($attempt = 0; $attempt -lt 3; $attempt++) {
        try {
            $value = (Read-InputUI -MessageContent $Message -MessageType 'Info' -Prompt $Prompt).Trim()
        } catch {
            Stop-Setup (Get-Message 'InputUnavailable')
        }
        if ($value) {
            return $value
        }
        Write-FeedbackUI -MessageContent (Get-Message 'ValueRequired') -MessageType 'Warning'
    }
    Stop-Setup (Get-Message 'ValueLimit')
}

function Read-ValueWithDefault {
    param(
        [string] $Title,
        [string] $Prompt,
        [string] $Default
    )

    $items = Get-FieldItems @((Get-Message 'DefaultField')) @($Default)
    try {
        $value = (
            Read-InputUI -TableTitle $Title -TableItems $items -TableTypes @(
                'Info'
            ) -TableKind 'Unordered' -Prompt $Prompt
        ).Trim()
    } catch {
        Stop-Setup (Get-Message 'InputUnavailable')
    }
    if ($value) {
        return $value
    }
    return $Default
}

function Read-ApiKey {
    param(
        [string] $Title,
        [string[]] $Items,
        [string[]] $Types
    )

    for ($attempt = 0; $attempt -lt 3; $attempt++) {
        try {
            $secureValue = Read-InputUI -TableTitle $Title -TableItems $Items -TableTypes $Types -TableKind 'Unordered' -Prompt (
                Get-Message 'ApiKeyPrompt'
            ) -AsSecureString
        } catch {
            Stop-Setup (Get-Message 'ApiKeyUnavailable')
        }
        $pointer = [IntPtr]::Zero
        try {
            $pointer = [Runtime.InteropServices.Marshal]::SecureStringToBSTR($secureValue)
            $plainValue = [Runtime.InteropServices.Marshal]::PtrToStringBSTR($pointer)
        } finally {
            if ($pointer -ne [IntPtr]::Zero) {
                [Runtime.InteropServices.Marshal]::ZeroFreeBSTR($pointer)
            }
        }
        if ($plainValue) {
            if ($plainValue -match '[\r\n]') {
                Stop-Setup (Get-Message 'ApiKeyLineBreaks')
            }
            return $plainValue
        }
        Write-FeedbackUI -MessageContent (Get-Message 'ApiKeyRequired') -MessageType 'Warning'
    }
    Stop-Setup (Get-Message 'ApiKeyLimit')
}

function Resolve-BaseUrl {
    param([string] $Value)

    $candidate = $Value.Trim()
    if (-not $candidate) {
        Stop-Setup (Get-Message 'BaseUrlRequired')
    }

    if ($candidate -notmatch '^[A-Za-z][A-Za-z0-9+.-]*://') {
        $localPattern = '^(?i)(localhost|0\.0\.0\.0|127(?:\.\d{1,3}){3}|10(?:\.\d{1,3}){3}|192\.168(?:\.\d{1,3}){2}|172\.(?:1[6-9]|2\d|3[01])(?:\.\d{1,3}){2}|\[::1\])(?::\d+)?(?:/|$)'
        $scheme = if ($candidate -match $localPattern) {
            'http'
        } else {
            'https'
        }
        $candidate = "${scheme}://$candidate"
        Write-FeedbackUI -MessageContent (Get-Message 'BaseUrlExpanded' $candidate) -MessageType 'Detail'
    }

    $parsed = $null
    if (-not [Uri]::TryCreate( $candidate, [UriKind]::Absolute, [ref] $parsed )) {
        Stop-Setup (Get-Message 'BaseUrlInvalid' $candidate)
    }
    if ($parsed.Scheme -notin @( 'http', 'https' )) {
        Stop-Setup (Get-Message 'BaseUrlScheme')
    }
    if ($parsed.UserInfo) {
        Stop-Setup (Get-Message 'BaseUrlCredentials')
    }
    return $parsed.AbsoluteUri
}

function New-SetupSelection {
    param(
        [string] $ProviderName,
        [string] $BaseUrl,
        [string] $Model,
        [AllowEmptyString()] [string] $ReasoningEffort,
        [Nullable[int]] $ContextWindow
    )

    return [pscustomobject] @{
        ProviderName = $ProviderName
        BaseUrl = $BaseUrl
        Model = $Model
        ReasoningEffort = $ReasoningEffort
        ContextWindow = $ContextWindow
    }
}

function Select-ModelPreset {
    $menuKeys = New-Object 'System.Collections.Generic.List[string]'
    $menuLines = New-Object 'System.Collections.Generic.List[string]'
    for ($index = 0; $index -lt $MODEL_PRESETS.Count; $index++) {
        $preset = $MODEL_PRESETS[$index]
        $default = if ($index -eq 0) {
            Get-Message 'DefaultMarker'
        } else {
            ''
        }
        $menuKeys.Add([string]($index + 1))
        $menuLines.Add((Get-Message 'ModelPresetFormat' @( $preset.Model, $default, $preset.ReasoningEffort )))
    }
    $manualChoice = $MODEL_PRESETS.Count + 1
    $menuKeys.Add([string] $manualChoice)
    $menuLines.Add((Get-Message 'ManualModelOption'))
    $choice = [int](
        Read-Choice -Title (Get-Message 'ModelMenuTitle') -Keys @($menuKeys) -Items @($menuLines) -Prompt (
            Get-Message 'SelectOption'
        )
    )
    if ($choice -eq $manualChoice) {
        $model = Read-RequiredValue -Message (Get-Message 'ModelInputMessage') -Prompt (Get-Message 'ModelPrompt')
        return [pscustomobject] @{ Model = $model; ReasoningEffort = ''; ContextWindow = $null }
    }
    return $MODEL_PRESETS[$choice - 1]
}

function Get-PresetSelection {
    $modelChoice = Select-ModelPreset
    $baseUrl = Resolve-BaseUrl (
        Read-ValueWithDefault -Title (Get-Message 'BaseUrlInputTitle') -Prompt (
            Get-Message 'DefaultBaseUrlPrompt'
        ) -Default 'https://api.openai.com/v1'
    )
    return New-SetupSelection 'OpenAI' $baseUrl $modelChoice.Model $modelChoice.ReasoningEffort $modelChoice.ContextWindow
}

function Get-ManualSelection {
    $providerName = Read-RequiredValue -Message (Get-Message 'ProviderInputMessage') -Prompt (
        Get-Message 'ProviderPrompt'
    )
    $baseUrl = Resolve-BaseUrl (
        Read-RequiredValue -Message (Get-Message 'BaseUrlInputMessage') -Prompt (Get-Message 'BaseUrlPrompt')
    )
    $model = Read-RequiredValue -Message (Get-Message 'ModelInputMessage') -Prompt (Get-Message 'ModelPrompt')
    return New-SetupSelection $providerName $baseUrl $model '' $null
}

function Get-ConfigLines {
    if (-not (Test-Path -LiteralPath $ConfigPath)) {
        return @()
    }
    $raw = Get-Content -LiteralPath $ConfigPath -Raw -Encoding UTF8
    if ($null -eq $raw -or $raw -eq '') {
        return @()
    }
    $raw = ( $raw -replace "`r`n", "`n" ).TrimEnd("`n")
    if (-not $raw) {
        return @()
    }
    return @($raw -split "`n")
}

function Remove-SelectionSettings {
    param([string[]] $Lines)

    if ($null -eq $Lines) {
        $Lines = @()
    }
    $managedKeys = @( 'model', 'model_provider', 'model_reasoning_effort', 'model_context_window' )
    $output = New-Object 'System.Collections.Generic.List[string]'
    $script:Depth = 0
    $script:MultilineState = ''
    $index = 0
    $inLeading = $true
    while ($index -lt $Lines.Count) {
        $line = $Lines[$index]
        $trimmed = $line.Trim()
        $isHeader = (-not $script:MultilineState) -and ($script:Depth -eq 0) -and $trimmed.StartsWith('[')
        if ($isHeader) {
            $inLeading = $false
            $output.Add($line)
            Update-TomlScanState $line
            $index++
            continue
        }
        if ($inLeading -and -not $script:MultilineState -and $script:Depth -eq 0) {
            $key = Get-TomlKey $line
            if ($key -and $managedKeys -ccontains $key) {
                Update-TomlScanState $line
                $index++
                while (($script:MultilineState -or $script:Depth -ne 0) -and $index -lt $Lines.Count) {
                    Update-TomlScanState $Lines[$index]
                    $index++
                }
                continue
            }
        }
        $output.Add($line)
        Update-TomlScanState $line
        $index++
    }
    return $output.ToArray()
}

function Split-TomlSections {
    param([string[]] $Lines)

    if ($null -eq $Lines) {
        $Lines = @()
    }
    $firstSection = - 1
    $script:Depth = 0
    $script:MultilineState = ''
    for ($i = 0; $i -lt $Lines.Count; $i++) {
        if (-not $script:MultilineState -and $script:Depth -eq 0 -and $Lines[$i].Trim().StartsWith('[')) {
            $firstSection = $i
            break
        }
        Update-TomlScanState $Lines[$i]
    }
    if ($firstSection -lt 0) {
        $firstSection = $Lines.Count
    }
    $leading = New-Object 'System.Collections.Generic.List[string]'
    for ($i = 0; $i -lt $firstSection; $i++) {
        $leading.Add($Lines[$i])
    }
    while ($leading.Count -gt 0 -and -not $leading[$leading.Count - 1].Trim()) {
        $leading.RemoveAt($leading.Count - 1)
    }
    $body = New-Object 'System.Collections.Generic.List[string]'
    for ($i = $firstSection; $i -lt $Lines.Count; $i++) {
        $body.Add($Lines[$i])
    }
    return [pscustomobject] @{
        Leading = $leading.ToArray()
        Body = $body.ToArray()
        HasBody = ($firstSection -lt $Lines.Count)
    }
}

function New-SelectedConfigContent {
    param(
        [string[]] $Lines,
        [pscustomobject] $Selection,
        [string] $ProviderId
    )

    $stripped = Remove-SelectionSettings $Lines
    $parts = Split-TomlSections $stripped
    $leading = New-Object 'System.Collections.Generic.List[string]'
    foreach ($item in $parts.Leading) {
        $leading.Add($item)
    }
    $leading.Add("model = $(ConvertTo-TomlString $Selection.Model)")
    $leading.Add("model_provider = $(ConvertTo-TomlString $ProviderId)")
    if ($Selection.ReasoningEffort) {
        $leading.Add("model_reasoning_effort = $(ConvertTo-TomlString $Selection.ReasoningEffort)")
    }
    if ($null -ne $Selection.ContextWindow) {
        $leading.Add("model_context_window = $([int]$Selection.ContextWindow)")
    }

    $final = New-Object 'System.Collections.Generic.List[string]'
    foreach ($item in $leading) {
        $final.Add($item)
    }
    if ($parts.HasBody) {
        $final.Add('')
    }
    foreach ($item in $parts.Body) {
        $final.Add($item)
    }
    while ($final.Count -gt 0 -and -not $final[$final.Count - 1].Trim()) {
        $final.RemoveAt($final.Count - 1)
    }
    return (($final -join "`n") + "`n")
}

function Add-ProviderSection {
    param(
        [string] $Content,
        [string] $ProviderId,
        [pscustomobject] $Selection,
        [string] $ApiKey
    )

    $prefix = $Content.TrimEnd( "`r", "`n" )
    return @(
        $prefix
        ''
        "[model_providers.$ProviderId]"
        "name = $(ConvertTo-TomlString $Selection.ProviderName)"
        "base_url = $(ConvertTo-TomlString $Selection.BaseUrl)"
        'wire_api = "responses"'
        "experimental_bearer_token = $(ConvertTo-TomlString $ApiKey)"
        ''
    ) -join "`n"
}

function Remove-ProviderSection {
    param(
        [string[]] $Lines,
        [string] $ProviderId
    )

    $output = New-Object 'System.Collections.Generic.List[string]'
    $script:Depth = 0
    $script:MultilineState = ''
    $skip = $false
    foreach ($line in $Lines) {
        $trimmed = $line.Trim()
        if (-not $script:MultilineState -and $script:Depth -eq 0 -and $trimmed.StartsWith('[')) {
            $skip = Test-ProviderSection $line $ProviderId
        }
        if (-not $skip) {
            $output.Add($line)
        }
        Update-TomlScanState $line
    }
    while ($output.Count -gt 0 -and -not $output[$output.Count - 1].Trim()) {
        $output.RemoveAt($output.Count - 1)
    }
    return (($output -join "`n") + "`n")
}

function Assert-GeneratedConfig {
    param(
        [string] $Content,
        [string] $ProviderId
    )

    $lines = @($Content.TrimEnd( "`r", "`n" ) -split "`r?`n")
    $seen = New-Object 'System.Collections.Generic.Dictionary[string,bool]'([System.StringComparer]::Ordinal)
    $script:Depth = 0
    $script:MultilineState = ''
    $inLeading = $true
    $providerCount = 0
    foreach ($line in $lines) {
        $trimmed = $line.Trim()
        if (-not $script:MultilineState -and $script:Depth -eq 0 -and $trimmed.StartsWith('[')) {
            $inLeading = $false
            if (Test-ProviderSection $line $ProviderId -Exact) {
                $providerCount++
            }
        }
        if ($inLeading -and -not $script:MultilineState -and $script:Depth -eq 0) {
            $key = Get-TomlKey $line
            if ($key) {
                if ($seen.ContainsKey($key)) {
                    throw (Get-Message 'DuplicateSetting' $key)
                }
                $seen[$key] = $true
            }
        }
        Update-TomlScanState $line
    }
    foreach ($required in @( 'model', 'model_provider' )) {
        if (-not $seen.ContainsKey($required)) {
            throw (Get-Message 'MissingSetting' $required)
        }
    }
    if ($providerCount -ne 1) {
        throw (Get-Message 'ProviderSectionCount' $ProviderId)
    }
}

function Get-OriginalConfigExisted {
    if (-not (Test-Path -LiteralPath $ManifestPath)) {
        Stop-Setup (Get-Message 'BackupIncomplete' $ManifestPath)
    }
    $manifest = Get-Content -LiteralPath $ManifestPath -Raw -Encoding UTF8
    if ($manifest -match '(?m)^original_config_existed=1$') {
        return $true
    }
    if ($manifest -match '(?m)^original_config_existed=0$') {
        return $false
    }
    Stop-Setup (Get-Message 'BackupManifestInvalid')
}

function Get-ManifestField {
    param([string] $Name)

    if (-not (Test-Path -LiteralPath $ManifestPath)) {
        return ''
    }
    $manifest = Get-Content -LiteralPath $ManifestPath -Raw -Encoding UTF8
    if ($manifest -match "(?m)^$([regex]::Escape($Name))=(.*)$") {
        return $Matches[1]
    }
    return ''
}

function Assert-Manifest {
    if ((Get-ManifestField 'format_version') -ne '1') {
        Stop-Setup (Get-Message 'BackupManifestInvalid')
    }
    $count = Get-ManifestField 'provider_count'
    if ($count -notmatch '^\d+$') {
        Stop-Setup (Get-Message 'BackupManifestInvalid')
    }
    $ids = New-Object 'System.Collections.Generic.HashSet[string]'([System.StringComparer]::Ordinal)
    for ($index = 1; $index -le [int] $count; $index++) {
        $id = Get-ManifestField "provider_${index}_id"
        $model = Get-ManifestField "provider_${index}_model"
        if ($id -notmatch '^codex_provider_setup_[1-9]\d*$' -or -not $ids.Add($id) -or -not $model) {
            Stop-Setup (Get-Message 'BackupManifestInvalid')
        }
    }
}

function Get-ProviderRecords {
    Assert-Manifest
    $records = New-Object 'System.Collections.Generic.List[pscustomobject]'
    $count = [int](Get-ManifestField 'provider_count')
    for ($index = 1; $index -le $count; $index++) {
        $id = Get-ManifestField "provider_${index}_id"
        $model = Get-ManifestField "provider_${index}_model"
        if (-not $id -or -not $model) {
            Stop-Setup (Get-Message 'BackupManifestInvalid')
        }
        $context = Get-ManifestField "provider_${index}_context_window"
        $records.Add(
            [pscustomobject] @{
                Id = $id
                Model = $model
                ReasoningEffort = Get-ManifestField "provider_${index}_reasoning_effort"
                ContextWindow = if ($context) {
                    [Nullable[int]] [int] $context
                } else {
                    $null
                }
            }
        )
    }
    return $records.ToArray()
}

function New-ManifestContent {
    param([pscustomobject[]] $Providers)

    $lines = New-Object 'System.Collections.Generic.List[string]'
    $lines.Add('format_version=1')
    $lines.Add("script_version=$SCRIPT_VERSION")
    $lines.Add("created_at=$(Get-ManifestField 'created_at')")
    $lines.Add("original_config_existed=$(if (Get-OriginalConfigExisted) { 1 } else { 0 })")
    $lines.Add("provider_count=$($Providers.Count)")
    for ($index = 0; $index -lt $Providers.Count; $index++) {
        $number = $index + 1
        $provider = $Providers[$index]
        $lines.Add("provider_${number}_id=$($provider.Id)")
        $lines.Add("provider_${number}_model=$($provider.Model)")
        $lines.Add("provider_${number}_reasoning_effort=$($provider.ReasoningEffort)")
        $lines.Add(
            "provider_${number}_context_window=$(if ($null -ne $provider.ContextWindow) { [int] $provider.ContextWindow } else { '' })"
        )
    }
    return (($lines -join "`n") + "`n")
}

function Initialize-Backup {
    if (Test-Path -LiteralPath $BackupDir) {
        $existed = Get-OriginalConfigExisted
        if ($existed -and -not (Test-Path -LiteralPath $BackupConfig)) {
            Stop-Setup (Get-Message 'BackupDamaged' $BackupConfig)
        }
        return
    }
    $existed = Test-Path -LiteralPath $ConfigPath
    New-Item -ItemType Directory -Path $BackupDir -Force | Out-Null
    if ($existed) {
        Copy-Item -LiteralPath $ConfigPath -Destination $BackupConfig -Force
    }
    $utf8 = New-Object System.Text.UTF8Encoding($false)
    $manifest = @(
        'format_version=1'
        "script_version=$SCRIPT_VERSION"
        "created_at=$(Get-Date -Format 'yyyy-MM-dd HH:mm:ss')"
        "original_config_existed=$(if ($existed) { 1 } else { 0 })"
        'provider_count=0'
    ) -join "`n"
    [IO.File]::WriteAllText( $ManifestPath, $manifest + "`n", $utf8 )
}

function Get-NextProviderId {
    param(
        [string[]] $Lines,
        [pscustomobject[]] $Providers
    )

    $used = New-Object 'System.Collections.Generic.HashSet[string]'([System.StringComparer]::Ordinal)
    foreach ($provider in $Providers) {
        [void] $used.Add($provider.Id)
    }
    $script:Depth = 0
    $script:MultilineState = ''
    foreach ($line in $Lines) {
        if (-not $script:MultilineState -and $script:Depth -eq 0 -and $line.Trim().StartsWith('[')) {
            $path = @(Get-TomlSectionPath $line)
            if ($path.Count -ge 2 -and $path[0] -ceq 'model_providers') {
                [void] $used.Add($path[1])
            }
        }
        Update-TomlScanState $line
    }
    for ($number = 1;; $number++) {
        $candidate = "$PROVIDER_PREFIX$number"
        if (-not $used.Contains($candidate)) {
            return $candidate
        }
    }
}

function Write-ConfigAndManifest {
    param(
        [string] $ConfigContent,
        [string] $ManifestContent
    )

    $utf8 = New-Object System.Text.UTF8Encoding($false)
    $configTemp = "$ConfigPath.$PID.tmp"
    $manifestTemp = "$ManifestPath.$PID.tmp"
    $rollback = "$ConfigPath.$PID.rollback"
    $hadConfig = Test-Path -LiteralPath $ConfigPath
    try {
        [IO.File]::WriteAllText( $configTemp, $ConfigContent, $utf8 )
        [IO.File]::WriteAllText( $manifestTemp, $ManifestContent, $utf8 )
        if ($hadConfig) {
            Copy-Item -LiteralPath $ConfigPath -Destination $rollback -Force
        }
        Move-Item -LiteralPath $configTemp -Destination $ConfigPath -Force
        try {
            Move-Item -LiteralPath $manifestTemp -Destination $ManifestPath -Force
        } catch {
            if ($hadConfig) {
                Move-Item -LiteralPath $rollback -Destination $ConfigPath -Force
            } else {
                Remove-Item -LiteralPath $ConfigPath -Force -ErrorAction SilentlyContinue
            }
            throw
        }
    } finally {
        Remove-Item -LiteralPath $configTemp, $manifestTemp, $rollback -Force -ErrorAction SilentlyContinue
    }
}

function Invoke-Configure {
    param([pscustomobject] $Selection)

    $summaryKeys = New-Object 'System.Collections.Generic.List[string]'
    $summaryValues = New-Object 'System.Collections.Generic.List[string]'
    $summaryKeys.Add((Get-Message 'ProviderField'))
    $summaryValues.Add($Selection.ProviderName)
    $summaryKeys.Add((Get-Message 'BaseUrlField'))
    $summaryValues.Add($Selection.BaseUrl)
    $summaryKeys.Add((Get-Message 'ModelField'))
    $summaryValues.Add($Selection.Model)
    if ($Selection.ReasoningEffort) {
        $summaryKeys.Add((Get-Message 'ReasoningField'))
        $summaryValues.Add($Selection.ReasoningEffort)
    }
    if ($null -ne $Selection.ContextWindow) {
        $summaryKeys.Add((Get-Message 'ContextField'))
        $summaryValues.Add([string] [int] $Selection.ContextWindow)
    }
    $summaryItems = New-Object 'System.Collections.Generic.List[string]'
    $summaryTypes = New-Object 'System.Collections.Generic.List[string]'
    foreach ($item in (Get-FieldItems @($summaryKeys) @($summaryValues))) {
        $summaryItems.Add($item)
        $summaryTypes.Add('Info')
    }
    $summaryItems.Add((Get-Message 'ApiKeyWarning'))
    $summaryTypes.Add('Warning')

    $apiKey = Read-ApiKey -Title (Get-Message 'ConfigSummaryTitle') -Items @($summaryItems) -Types @($summaryTypes)
    [void](Initialize-Backup)
    $lines = @(Get-ConfigLines)
    $providers = New-Object 'System.Collections.Generic.List[pscustomobject]'
    foreach ($provider in @(Get-ProviderRecords)) {
        if (-not (Get-ProviderInfo $lines $provider.Id).Present) {
            Stop-Setup (Get-Message 'ManagedProviderMissing' $provider.Id)
        }
        $providers.Add($provider)
    }
    $providerId = Get-NextProviderId $lines($providers.ToArray())
    $content = New-SelectedConfigContent $lines $Selection $providerId
    $content = Add-ProviderSection $content $providerId $Selection $apiKey
    $providers.Add(
        [pscustomobject] @{
            Id = $providerId
            Model = $Selection.Model
            ReasoningEffort = $Selection.ReasoningEffort
            ContextWindow = $Selection.ContextWindow
        }
    )
    try {
        Assert-GeneratedConfig $content $providerId
    } catch {
        Stop-Setup (Get-Message 'GeneratedConfigInvalid' $_.Exception.Message)
    }

    try {
        Write-ConfigAndManifest $content(New-ManifestContent $providers.ToArray())
    } catch {
        Stop-Setup (Get-Message 'ConfigWriteFailed' @( $BackupDir, $_.Exception.Message ))
    } finally {
        $apiKey = $null
    }

    Write-FeedbackUI -MessageContent (Get-Message 'ConfigUpdated' $ConfigPath) -MessageType 'Success'
    Write-FeedbackUI -TableTitle (Get-Message 'ConfigCompleteTitle') -TableItems @(
        (Get-Message 'ProviderAdded' $Selection.ProviderName),
        (Get-Message 'RestartCodex'),
        (Get-Message 'ConfirmModel' $Selection.Model)
    ) -TableTypes @( 'Success', 'Success', 'Detail' ) -TableKind 'Unordered'
}

function Invoke-Restore {
    Write-FeedbackUI -MessageContent "$(Get-Message 'RestoreTitle'). $(Get-Message 'RestoreWarning')" -MessageType 'Warning'
    if (-not (Test-Path -LiteralPath $BackupDir)) {
        Stop-Setup (Get-Message 'BackupUnavailable')
    }
    Assert-Manifest
    $existed = Get-OriginalConfigExisted
    if ($existed -and -not (Test-Path -LiteralPath $BackupConfig)) {
        Stop-Setup (Get-Message 'BackupDamaged' $BackupConfig)
    }
    $answer = Read-Choice -Title (Get-Message 'RestoreChoiceTitle') -Keys @( '1', '2' ) -Items @(
        (Get-Message 'RestoreConfirmAction'),
        (Get-Message 'CancelAction')
    ) -Prompt (Get-Message 'SelectOption')
    if ($answer -eq '2') {
        Write-FeedbackUI -MessageContent (Get-Message 'RestoreCanceled') -MessageType 'Info'
        return
    }
    $result = Get-Message 'ConfigAlreadyAbsent'
    if ($existed) {
        $temp = "$ConfigPath.$PID.restore"
        Copy-Item -LiteralPath $BackupConfig -Destination $temp -Force
        Move-Item -LiteralPath $temp -Destination $ConfigPath -Force
        $result = Get-Message 'ConfigRestored'
    } elseif (Test-Path -LiteralPath $ConfigPath) {
        Remove-Item -LiteralPath $ConfigPath -Force
        $result = Get-Message 'ConfigDeleted'
    }
    Remove-Item -LiteralPath $BackupDir -Recurse -Force
    Write-FeedbackUI -TableTitle (Get-Message 'RestoreCompleteTitle') -TableItems @(
        $result,
        (Get-Message 'BackupRemoved'),
        (Get-Message 'RestartCodex')
    ) -TableTypes @( 'Success', 'Success', 'Detail' ) -TableKind 'Unordered'
}

function Get-ProviderViews {
    if (-not (Test-Path -LiteralPath $BackupDir)) {
        return @()
    }
    $lines = @(Get-ConfigLines)
    $views = New-Object 'System.Collections.Generic.List[pscustomobject]'
    foreach ($record in @(Get-ProviderRecords)) {
        $info = Get-ProviderInfo $lines $record.Id
        if (-not $info.Present) {
            Stop-Setup (Get-Message 'ManagedProviderMissing' $record.Id)
        }
        $views.Add(
            [pscustomobject] @{
                Id = $record.Id
                Model = $record.Model
                ReasoningEffort = $record.ReasoningEffort
                ContextWindow = $record.ContextWindow
                ProviderName = $info.ProviderName
                BaseUrl = $info.BaseUrl
                Recognizable = $info.Recognizable
            }
        )
    }
    return $views.ToArray()
}

function Select-ProviderView {
    param(
        [string] $Title,
        [pscustomobject[]] $Providers
    )

    $keys = New-Object 'System.Collections.Generic.List[string]'
    $items = New-Object 'System.Collections.Generic.List[string]'
    for ($index = 0; $index -lt $Providers.Count; $index++) {
        $keys.Add([string]($index + 1))
        $provider = $Providers[$index]
        $name = if ($provider.ProviderName) {
            $provider.ProviderName
        } else {
            $provider.Id
        }
        $items.Add((Get-Message 'ProviderListItem' @( $name, $provider.Model, $provider.BaseUrl )))
    }
    $choice = [int](Read-Choice $Title $keys.ToArray() $items.ToArray() (Get-Message 'SelectOption'))
    return $Providers[$choice - 1]
}

function Invoke-SwitchProvider {
    $providers = @(Get-ProviderViews)
    if ($providers.Count -eq 0) {
        Write-FeedbackUI -MessageContent (Get-Message 'NothingToSwitch') -MessageType 'Info'
        return
    }
    $provider = Select-ProviderView (Get-Message 'SwitchTitle') $providers
    $selection = New-SetupSelection $provider.ProviderName $provider.BaseUrl $provider.Model $provider.ReasoningEffort $provider.ContextWindow
    $content = New-SelectedConfigContent (Get-ConfigLines) $selection $provider.Id
    $temp = "$ConfigPath.$PID.switch"
    try {
        Assert-GeneratedConfig $content $provider.Id
        [IO.File]::WriteAllText( $temp, $content, (New-Object System.Text.UTF8Encoding($false)) )
        Move-Item -LiteralPath $temp -Destination $ConfigPath -Force
    } catch {
        Stop-Setup (Get-Message 'ConfigWriteFailed' @( $BackupDir, $_.Exception.Message ))
    } finally {
        Remove-Item -LiteralPath $temp -Force -ErrorAction SilentlyContinue
    }
    Write-FeedbackUI -MessageContent (Get-Message 'ProviderSwitched' $provider.ProviderName) -MessageType 'Success'
}

function Invoke-RemoveProvider {
    $providers = @(Get-ProviderViews)
    $currentId = Get-TopLevelSetting (Get-ConfigLines) 'model_provider'
    $removable = @(
        $providers | Where-Object {
            $_.Id -cne $currentId
        }
    )
    if ($removable.Count -eq 0) {
        Write-FeedbackUI -MessageContent (Get-Message 'NothingToRemove') -MessageType 'Info'
        return
    }
    $provider = Select-ProviderView (Get-Message 'RemoveProviderTitle') $removable
    if (-not $provider.Recognizable) {
        Stop-Setup (Get-Message 'ManagedProviderModified' $provider.Id)
    }
    $answer = Read-Choice (Get-Message 'RemoveProviderTitle') @( '1', '2' ) @(
        (Get-Message 'RemoveProviderConfirm' $provider.ProviderName),
        (Get-Message 'CancelAction')
    ) (Get-Message 'SelectOption')
    if ($answer -eq '2') {
        return
    }
    $remaining = @(
        $providers | Where-Object {
            $_.Id -cne $provider.Id
        }
    )
    $content = Remove-ProviderSection (Get-ConfigLines) $provider.Id
    try {
        Write-ConfigAndManifest $content(New-ManifestContent $remaining)
    } catch {
        Stop-Setup (Get-Message 'ConfigWriteFailed' @( $BackupDir, $_.Exception.Message ))
    }
    Write-FeedbackUI -MessageContent (Get-Message 'ProviderRemoved' $provider.ProviderName) -MessageType 'Success'
}

function Get-SetupActions {
    return @(
        [pscustomobject] @{
            Key = '1'
            Label = Get-Message 'ModelPresetsAction'
            Action =
                {
                    Invoke-Configure (Get-PresetSelection)
                }
        }
        [pscustomobject] @{
            Key = '2'
            Label = Get-Message 'ManualSetupAction'
            Action =
                {
                    Invoke-Configure (Get-ManualSelection)
                }
        }
        [pscustomobject] @{
            Key = '3'
            Label = Get-Message 'SwitchProviderAction'
            Action =
                {
                    Invoke-SwitchProvider
                }
        }
        [pscustomobject] @{
            Key = '4'
            Label = Get-Message 'RemoveProviderAction'
            Action =
                {
                    Invoke-RemoveProvider
                }
        }
        [pscustomobject] @{
            Key = '9'
            Label = Get-Message 'RestoreAction'
            Action =
                {
                    Invoke-Restore
                }
        }
    )
}

function Invoke-CodexProviderSetup {
    $ErrorActionPreference = 'Stop'
    Set-StrictMode -Version Latest
    Write-FeedbackUI -TableTitle (
        Get-Message 'AppTitle' $SCRIPT_VERSION
    ) -TableItems @((Get-Message 'CodexHome' $CodexHomeDir)) -TableTypes @('Detail') -TableKind 'Unordered'
    if (-not (Test-Path -LiteralPath $CodexHomeDir)) {
        Stop-Setup (Get-Message 'CodexHomeMissing' $CodexHomeDir)
    }
    $actions = Get-SetupActions
    $choice = Read-Choice -Title (Get-Message 'SetupModeTitle') -Keys @($actions.Key) -Items @($actions.Label) -Prompt (
        Get-Message 'SelectOption'
    )
    $action = @(
        $actions | Where-Object {
            $_.Key -eq $choice
        }
    )[0]
    & $($action.Action)
}

if ($env:CODEX_PROVIDER_SETUP_SKIP_MAIN -ne '1') {
    try {
        Invoke-CodexProviderSetup
    }
    catch {
        if ("$_" -ne $ABORT_SENTINEL) {
            throw
        }
        if ($PSCommandPath) {
            exit 1
        }
    }
}
